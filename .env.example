# Local development:
# - point these at the Supabase branch named "development"
# - never point local .env at the Supabase main / production branch
# - local Supabase access is blocked unless SUPABASE_ENVIRONMENT=development
SUPABASE_URL=https://your-development-branch-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-development-branch-service-role-key
SUPABASE_SCHEMA=public
USE_SUPABASE=true
SUPABASE_ENVIRONMENT=development
SUPABASE_BRANCH_NAME=development
ALLOW_PRODUCTION_SUPABASE_LOCALLY=false
PORT=8000
# Optional: force the public base URL used in generated share links and metadata.
# Leave unset in local dev to use the current request origin automatically.
# PUBLIC_APP_ORIGIN=http://127.0.0.1:8000
